# Connection string do seu banco Postgres (obrigatória).
# Local (Postgres instalado na sua máquina):
# DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/vidamaissaude
#
# Render (Internal Database URL, copiada da página do seu banco Postgres):
# DATABASE_URL=postgresql://usuario:senha@dpg-xxxxx-a/vidamaissaude
DATABASE_URL=

# Porta em que o servidor sobe localmente (o Render define isso sozinho em produção)
PORT=4000

# URL(s) do frontend autorizadas a chamar esta API, separadas por vírgula.
# Deixe vazio para permitir qualquer origem (ok para desenvolvimento local).
# Em produção, defina com a URL exata do Vercel, ex:
# FRONTEND_URL=https://seu-app.vercel.app
FRONTEND_URL=
